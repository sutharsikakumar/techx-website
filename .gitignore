# Dependencies and build output
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Environment (copy .env.example to .env.local; never commit real values)
.env
.env*.local

# OS / editor
.DS_Store

# Local-only source material: big originals and design files that are not part
